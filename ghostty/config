font-family = "Source Code Pro"
keybind = cmd+shift+equal=increase_font_size:1

## tmux bindings

keybind = cmd+t=text:\x1c\x63
keybind = cmd+w=text:\x1c\x77
keybind = cmd+shift+enter=text:\x1c\x78

# swap panes
keybind = cmd+shift+9=text:\x1c\x28
keybind = cmd+shift+0=text:\x1c\x29

# move window
keybind = cmd+period=text:\x1c\x2e
# rename window (TODO, overlaps with ghostty)
# keybind = cmd+shift+comma=text:\x1c\x2c

keybind = super+digit_0=unbind
keybind = super+digit_1=unbind
keybind = super+digit_2=unbind
keybind = super+digit_3=unbind
keybind = super+digit_4=unbind
keybind = super+digit_5=unbind
keybind = super+digit_6=unbind
keybind = super+digit_7=unbind
keybind = super+digit_8=unbind
keybind = super+digit_9=unbind

keybind = super+0=text:\x1c\x30
keybind = super+1=text:\x1c\x31
keybind = super+2=text:\x1c\x32
keybind = super+3=text:\x1c\x33
keybind = super+4=text:\x1c\x34
keybind = super+5=text:\x1c\x35
keybind = super+6=text:\x1c\x36
keybind = super+7=text:\x1c\x37
keybind = super+8=text:\x1c\x38
keybind = super+9=text:\x1c\x39

keybind = super+ctrl+h=text:\x1c\x08
keybind = super+ctrl+j=text:\x1c\x0a
keybind = super+ctrl+k=text:\x1c\x0b
keybind = super+ctrl+l=text:\x1c\x0c

keybind = global:super+ctrl+`=toggle_visibility

keybind = cmd+shift+semicolon=text:\x1c\x3a
keybind = cmd+equal=text:\x1c\x3d

# select-layout even-horizontal
keybind = cmd+shift+2=text:\x1c\x40
# select-layout even-vertical
keybind = cmd+shift+1=text:\x1c\x21
keybind = cmd+l=text:\x1c\x6c

keybind = cmd+shift+j=text:\x1c\x7d
keybind = cmd+shift+k=text:\x1c\x7b
keybind = cmd+shift+left_bracket=text:\x1c\x7b
keybind = cmd+shift+right_bracket=text:\x1c\x7d

keybind = cmd+j=text:\x1c\x5d
keybind = cmd+k=text:\x1c\x5b
keybind = cmd+[=text:\x1c\x5b
keybind = cmd+]=text:\x1c\x5d

# pane splitting
keybind = cmd+shift+minus=text:\x1c\x5F
keybind = cmd+shift+backslash=text:\x1c\x7c

keybind = cmd+shift+l=text:\x1c\x4c

keybind = cmd+p=text:\x1c\x70
keybind = cmd+shift+p=text:\x1c\x50

# attach to other session
# keybind = cmd+a=text:\x1c\x44
keybind = cmd+s=text:\x1c\x73

keybind = cmd+d=text:\x1c\x64
keybind = cmd+g=text:\x1c\x67
keybind = cmd+h=text:\x1c\x68

clipboard-paste-bracketed-safe = true

# custom-shader = shaders/cursor_smear_original.glsl
